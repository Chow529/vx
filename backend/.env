# ============================================================
# 知问库后端配置文件 (.env)
# 作用：把环境相关配置从代码里抽出来，改这里即可，无需改代码。
# 由 app/config.py 通过 pydantic-settings 自动读取。
# ============================================================

# ─── 微信小程序配置 (从微信公众平台获取) ───
WECHAT_APP_ID=your_app_id_here
WECHAT_APP_SECRET=your_app_secret_here

# ─── JWT 密钥 (生产环境请使用强随机字符串) ───
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30

# ─── 数据库配置 ───
# DB_TYPE 可选值：mysql 或 sqlite
#   mysql  -> 走下面的 MYSQL_* 字段
#   sqlite -> 走 SQLITE_PATH（无需安装 MySQL 时可临时切回）
DB_TYPE=mysql

# MySQL 连接信息（请根据你的实际数据库修改）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=fairytail
MYSQL_DB=vx

# SQLite 路径（仅当 DB_TYPE=sqlite 时生效）
SQLITE_PATH=./data/knowledge.db

# 高级用法：如需手动指定完整连接串，取消下面注释并填写，它将覆盖上面的自动拼装
# DATABASE_URL=mysql+pymysql://root:密码@127.0.0.1:3306/knowledge?charset=utf8mb4

# ─── 向量模型 (首次运行会自动下载，约 400MB) ───
EMBEDDING_MODEL=shibing624/text2vec-base-chinese
