/* pages/profile/profile.wxss */
.container { padding-bottom: 40rpx; }

.user-header {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
}
/* 头像按钮：去掉小程序 button 默认边框和背景 */
.avatar-btn {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  margin: 0 28rpx 0 0;
  background: transparent;
  line-height: normal;
  border-radius: 50%;
}
.avatar-btn::after { border: none; }
.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #eee;
  display: block;
}
/* 头像右下角的小铅笔，提示可点击修改 */
.avatar-edit {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 20rpx;
  color: #fff;
  background: #4A90D9;
  border: 2rpx solid #fff;
  border-radius: 50%;
}
.user-info { flex: 1; }
.user-name-input {
  font-size: 36rpx;
  font-weight: 600;
  display: block;
  padding: 4rpx 0;
  min-height: 44rpx;
}
.user-name {
  font-size: 36rpx;
  font-weight: 600;
  display: block;
}
.user-meta { display: flex; align-items: center; margin-top: 8rpx; }
.user-reputation {
  font-size: 24rpx;
  color: #999;
}
.admin-badge {
  font-size: 20rpx;
  color: #722ed1;
  background: rgba(114, 46, 209, 0.1);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-right: 12rpx;
  line-height: 1.6;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  display: block;
}

.stat-row { padding: 12rpx 0; }
.stat-item { text-align: center; flex: 1; }
.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #4A90D9;
  display: block;
}
.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.progress-item { margin-bottom: 20rpx; }
.progress-item text { font-size: 24rpx; color: #666; }
.progress-bar {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  margin-top: 8rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4A90D9, #67b8f5);
  border-radius: 6rpx;
  transition: width 0.3s;
}

.tech-grid {
  display: flex;
  flex-wrap: wrap;
}
.tech-item {
  width: 50%;
  padding: 12rpx 0;
}
.tech-name {
  font-size: 26rpx;
  color: #333;
}
.tech-count {
  font-size: 22rpx;
  color: #999;
  margin-left: 8rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  font-size: 28rpx;
}
.arrow {
  color: #ccc;
  font-size: 36rpx;
}
