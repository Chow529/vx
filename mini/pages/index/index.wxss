/* pages/index/index.wxss */
.container { padding-bottom: 20rpx; }

.sort-bar {
  padding: 20rpx 24rpx;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
}
.sort-item {
  padding: 10rpx 28rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 20rpx;
  margin-right: 16rpx;
}
.sort-item.active {
  background: #4A90D9;
  color: #fff;
}

.post-card { padding: 28rpx; }
.post-title {
  font-size: 32rpx;
  font-weight: 600;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.solved-badge {
  font-size: 22rpx;
  color: #52c41a;
  border: 1rpx solid #52c41a;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}
.post-content {
  font-size: 26rpx;
  color: #666;
  margin: 12rpx 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.tag-row { margin: 12rpx 0; }

.post-footer { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #f0f0f0; }
.avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}
.nickname { font-size: 24rpx; color: #999; margin-right: 16rpx; }
.time { font-size: 22rpx; color: #bbb; }

.actions { gap: 20rpx; }
.action-item { font-size: 24rpx; color: #999; }
.collect-btn { color: #4A90D9; }

.loading { text-align: center; padding: 30rpx; color: #999; font-size: 24rpx; }
