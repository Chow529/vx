/* pages/public-questions/public-questions.wxss */
.container { padding: 20rpx 24rpx 40rpx; background: #f5f6f8; min-height: 100vh; }

.page-header { margin-bottom: 30rpx; }
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  display: block;
}
.page-desc {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-top: 8rpx;
}

.group-section { margin-bottom: 30rpx; }
.group-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.group-icon {
  font-size: 36rpx;
  margin-right: 10rpx;
}
.group-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.tech-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.tech-card {
  width: calc(33.33% - 12rpx);
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.tech-card:active {
  background: #f0f0f0;
}
.tech-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}
