<!--pages/public-questions/public-questions.wxml - 技术栈图标网格首页-->
<view class="container">
  <view class="page-header">
    <text class="page-title">公共题库</text>
    <text class="page-desc">选择一个技术栈浏览题目</text>
  </view>

  <view wx:for="{{techGroups}}" wx:key="name" class="group-section">
    <view class="group-header">
      <text class="group-icon">{{item.icon}}</text>
      <text class="group-name">{{item.name}}</text>
    </view>
    <view class="tech-grid">
      <view wx:for="{{item.items}}" wx:for-item="tech" wx:key="*this"
            class="tech-card"
            bindtap="goTechList"
            data-tech="{{tech}}">
        <text class="tech-name">{{tech}}</text>
      </view>
    </view>
  </view>
</view>
