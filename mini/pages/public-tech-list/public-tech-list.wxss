/* pages/public-tech-list/public-tech-list.wxss */
.container { padding-bottom: 40rpx; background: #f5f6f8; min-height: 100vh; }

.upload-btn {
  margin: 20rpx 24rpx;
  background: #4A90D9;
  color: #fff;
  text-align: center;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
}
.upload-btn:active { opacity: 0.85; }

.upload-form { margin: 0 24rpx 20rpx; padding: 24rpx; }
.form-group { margin-bottom: 20rpx; }
.label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
  display: block;
}
.input {
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}
.textarea { min-height: 120rpx; }
.picker { color: #333; }

.question-card { margin: 16rpx 24rpx; padding: 24rpx; }
.q-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}
.q-title {
  font-size: 30rpx;
  font-weight: 600;
  flex: 1;
  margin-right: 12rpx;
}
.q-content {
  font-size: 26rpx;
  color: #666;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 12rpx;
}
.q-footer {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #999;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
}
.q-meta { margin-right: 16rpx; }

.loading { text-align: center; padding: 40rpx; color: #999; }
.empty { text-align: center; padding: 80rpx 0; color: #999; }
