<!--pages/file-import/file-import.wxml - 文件导入题库-->
<view class="container">
  <!-- 文件选择区域 -->
  <view class="card upload-section">
    <view class="section-title">第一步: 选择文件</view>
    <view class="file-info" wx:if="{{fileName}}">
      <text class="file-name">{{fileName}}</text>
      <text class="file-tip">支持 PDF / Word / Markdown</text>
    </view>
    <view wx:else class="empty-file">
      <text class="empty-text">点击选择文件</text>
    </view>
    <button class="btn-primary choose-btn" bindtap="chooseFile" disabled="{{parsing}}">
      {{fileName ? '重新选择' : '选择文件'}}
    </button>
  </view>

  <!-- 解析结果预览（流式逐条呈现） -->
  <view class="card preview-section" wx:if="{{items.length > 0 || parsing}}">
    <view class="section-title flex-between">
      <text>第二步: 预览并选择 ({{selectedIds.length}}/{{items.length}})</text>
      <text wx:if="{{!parsing}}" class="select-all" bindtap="toggleSelectAll">{{selectAll ? '取消全选' : '全选'}}</text>
    </view>

    <!-- 解析进度 / 停止提示 -->
    <view wx:if="{{parsing}}" class="progress-tip">
      <text class="dot-anim">●</text>
      <text>AI 正在逐题分析… 已呈现 {{items.length}}{{total ? ' / ' + total : ''}} 条</text>
    </view>
    <view wx:elif="{{stopped}}" class="progress-tip stopped">
      已手动停止解析，保留 {{items.length}} 条，可直接勾选导入
    </view>

    <scroll-view scroll-y class="item-list">
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="item-card {{item.selected ? 'selected' : ''}}"
        bindtap="toggleItem"
        data-index="{{index}}"
      >
        <view class="item-header">
          <text class="item-num">#{{index + 1}}</text>
          <view class="item-tags">
            <text class="tag">{{item.tech_stack}}</text>
            <text class="tag {{item.difficultyClass}}">{{item.difficultyLabel}}</text>
          </view>
          <view class="check-box {{item.selected ? 'checked' : ''}}">{{item.selected ? '✓' : ''}}</view>
        </view>
        <text wx:if="{{item.section}}" class="item-section">📁 {{item.section}}</text>
        <text class="item-question">{{item.preview}}</text>
        <text wx:if="{{item.answer}}" class="item-answer">答案: {{item.answer}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 导入配置 -->
  <view class="card config-section" wx:if="{{items.length > 0 && !parsing}}">
    <view class="section-title">第三步: 配置属性</view>
    
    <view class="config-item">
      <text class="config-label">技术栈</text>
      <picker mode="selector" range="{{techOptions}}" bindchange="pickTech">
        <view class="picker-value">{{techStack}} ▾</view>
      </picker>
    </view>

    <view class="config-item">
      <text class="config-label">难度</text>
      <picker mode="selector" range="{{difficultyOptions}}" bindchange="pickDifficulty">
        <view class="picker-value">{{difficultyOptions[difficulty - 1]}} ▾</view>
      </picker>
    </view>
  </view>

  <!-- 底部按钮区域 -->
  <view class="bottom-bar">
    <!-- 解析中：显示停止按钮 -->
    <button wx:if="{{parsing}}" class="btn-stop bottom-btn" bindtap="stopParse">
      停止解析
    </button>
    <!-- 已有结果：显示导入按钮 -->
    <button wx:elif="{{items.length > 0}}" class="btn-primary bottom-btn" bindtap="importQuestions" disabled="{{submitting || selectedIds.length === 0}}">
      {{submitting ? '导入中...' : '导入 ' + selectedIds.length + ' 道题目到题库'}}
    </button>
    <!-- 仅选了文件：显示解析按钮 -->
    <button wx:elif="{{fileName}}" class="btn-primary bottom-btn" bindtap="parseFile">
      开始解析
    </button>
  </view>
</view>
