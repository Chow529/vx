/* pages/file-import/file-import.wxss */
.container { padding-bottom: 120rpx; }

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.upload-section { padding: 32rpx; }

.file-info {
  background: #f5f5f5;
  padding: 20rpx;
  border-radius: 12rpx;
  margin: 20rpx 0;
}
.file-name {
  font-size: 28rpx;
  color: #333;
  display: block;
  word-break: break-all;
}
.file-tip {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.empty-file {
  text-align: center;
  padding: 40rpx 0;
}
.empty-text { color: #999; font-size: 28rpx; }

.choose-btn { margin-top: 20rpx; height: 80rpx; line-height: 80rpx; }
.parse-btn { height: 80rpx; line-height: 80rpx; }

.preview-section { padding: 24rpx; }

.select-all {
  font-size: 26rpx;
  color: #4A90D9;
}

.item-list {
  max-height: 600rpx;
}

.item-card {
  background: #f9f9f9;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.item-card.selected {
  border-color: #4A90D9;
  background: rgba(74, 144, 217, 0.05);
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
  gap: 8rpx;
}
.item-num {
  font-size: 24rpx;
  color: #999;
}
.item-tags {
  display: flex;
  gap: 8rpx;
  flex: 1;
  justify-content: flex-start;
}
.check-box {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #4A90D9;
  flex-shrink: 0;
}
.check-box.checked {
  background: #4A90D9;
  color: #fff;
  border-color: #4A90D9;
}

.tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  font-size: 22rpx;
  border-radius: 8rpx;
  color: #4A90D9;
  background: rgba(74, 144, 217, 0.1);
}
.tag.green {
  color: #52c41a;
  background: rgba(82, 196, 26, 0.1);
}
.tag.orange {
  color: #fa8c16;
  background: rgba(250, 140, 22, 0.1);
}
.tag.red {
  color: #f5222d;
  background: rgba(245, 34, 45, 0.1);
}

.item-question {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}
.item-answer {
  font-size: 24rpx;
  color: #666;
  display: block;
}

.config-section { padding: 24rpx; }
.config-item { margin-bottom: 20rpx; }
.config-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
  display: block;
}
.picker-value {
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #333;
}

.import-btn-wrap { margin: 20rpx 24rpx; }
.import-btn {
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  border-radius: 16rpx;
}

/* 底部固定按钮栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}
.bottom-btn {
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  border-radius: 16rpx;
  width: 100%;
}
